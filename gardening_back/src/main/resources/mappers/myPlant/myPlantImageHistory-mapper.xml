<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ggirick.gardening_back.mappers.myPlant.MyPlantImageHistoryMapper">

    <!-- 1. 히스토리 단건 조회 (PK 기반) -->
    <select id="getById" resultType="com.ggirick.gardening_back.dto.myPlant.MyPlantImageHistoryDTO">
        SELECT *
        FROM my_plant_image_history
        WHERE image_history_id = #{imageHistoryId}
    </select>

    <!-- 2. 동일 이미지 재삽입 방지 -->
    <delete id="deleteByHash">
        DELETE FROM my_plant_image_history
        WHERE hash = #{hash}
    </delete>

    <!-- 3. 신규 히스토리 저장 (SELECT KEY로 PK 채움) -->
    <insert id="insert" parameterType="com.ggirick.gardening_back.dto.myPlant.MyPlantImageHistoryDTO">
        <selectKey keyProperty="imageHistoryId" resultType="int" order="BEFORE">
            SELECT my_plant_image_history_seq.NEXTVAL FROM dual
        </selectKey>

        INSERT INTO my_plant_image_history (
        image_history_id, user_plant_id,
        ori_name, sys_name, url, hash
        ) VALUES (
        #{imageHistoryId},
        #{userPlantId},
        #{oriName},
        #{sysName},
        #{url},
        #{hash}
        )
    </insert>

    <!-- 4. 최신순 히스토리 목록 조회 -->
    <select id="getHistoryList" resultType="com.ggirick.gardening_back.dto.myPlant.MyPlantImageHistoryDTO">
        SELECT *
        FROM my_plant_image_history
        WHERE user_plant_id = #{userPlantId}
        ORDER BY created_at DESC
    </select>

    <!-- 5. 가장 오래된 히스토리 조회 (삭제 전 정보 확보) -->
    <select id="getOldest" resultType="com.ggirick.gardening_back.dto.myPlant.MyPlantImageHistoryDTO">
        SELECT *
        FROM my_plant_image_history
        WHERE user_plant_id = #{userPlantId}
        ORDER BY created_at ASC
            FETCH FIRST 1 ROW ONLY
    </select>

    <!-- 6. 히스토리 삭제 (PK 기반) -->
    <delete id="deleteByHistoryId">
        DELETE FROM my_plant_image_history
        WHERE image_history_id = #{imageHistoryId}
    </delete>

</mapper>
