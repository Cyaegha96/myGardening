<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ggirick.gardening_back.mappers.dashboard.DashboardMapper">
<select id="getRecentPosts" resultType="com.ggirick.gardening_back.dto.dashboard.DashboardPostDTO">
    select * from board where writer_uid = #{uid}
    order by created_at desc fetch first #{limit} rows only
</select>
</mapper>