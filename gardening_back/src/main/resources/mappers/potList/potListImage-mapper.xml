<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ggirick.gardening_back.mappers.potList.PotListImageMapper">
    <!--    분양글 이미지 목록 조회-->
    <select id="getImagesByPotListingId" resultType="com.ggirick.gardening_back.dto.potList.PotListImageDTO">
        SELECT url FROM pot_listing_image WHERE pot_listing_id = #{id} ORDER BY id
    </select>

    <!--    id에 따른 이미지 url조회-->
    <select id="getImageById" resultType="string">
        SELECT url FROM pot_listing_image WHERE id = #{id}
    </select>

    <!--    이미지 등록-->
    <insert id="insertImage">
        INSERT INTO pot_listing_image(id, pot_listing_id, url) VALUES(pot_listing_image_seq.nextval, #{id}, #{url})
    </insert>

    <!--    이미지 삭제-->
    <delete id="deleteImageById">
        DELETE FROM pot_listing_image WHERE id = #{id}
    </delete>
</mapper>